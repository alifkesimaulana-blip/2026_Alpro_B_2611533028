print("=== SISTEM LOKET ALPRO ADVENTURE PARK ===")
nama_3028 = input("Masukkan Nama Pengunjung        : ")
umur_3028 = int(input("Input umur anda                 : "))
sim_3028 = input("Apakah Anda Sudah Punya SIM C (y/t): ").strip().lower()[0]

print("\nPilihan Paket Wahana (1-5):")
print("  1. Safari Rimba         (Rp 50,000)")
print("  2. Arung Jeram          (Rp 75,000)")
print("  3. Motor ATV Ekstrim    (Rp 120,000)")
print("  4. Roller Coaster Kilat (Rp 100,000)")
print("  5. All-Access VIP       (Rp 220,000)")
paket_3028 = int(input("Masukkan nomor paket (1-5)      : "))
jumlah_tiket_3028 = int(input("Masukkan jumlah tiket           : "))

# 1) if tunggal - validasi kuota tiket
if jumlah_tiket_3028 <= 0:
    print("Peringatan: Jumlah tiket tidak valid!")

# 2) match-case - pemilihan wahana (case 1-5 dan default _)
match paket_3028:
    case 1:
        nama_wahana_3028 = "Wahana Safari Rimba"
        harga_satuan_3028 = 50000
    case 2:
        nama_wahana_3028 = "Wahana Arung Jeram"
        harga_satuan_3028 = 75000
    case 3:
        nama_wahana_3028 = "Wahana Motor ATV Ekstrim"
        harga_satuan_3028 = 120000
    case 4:
        nama_wahana_3028 = "Wahana Roller Coaster Kilat"
        harga_satuan_3028 = 100000
    case 5:
        nama_wahana_3028 = "Wahana All-Access VIP"
        harga_satuan_3028 = 220000
    case _:
        print("Paket wahana tidak valid!")


# 3) if-elif-else dengan operator logika (and, !=) - validasi izin kendali wahana
if paket_3028 == 3 and umur_3028 >= 17 and sim_3028 == 'y':
    print("Anda sudah dewasa dan boleh mengendarai ATV sendiri.")
elif paket_3028 == 3 and umur_3028 >= 17 and sim_3028 != 'y':
    print("Anda sudah dewasa tetapi tidak boleh bawa motor ATV (wajib didampingi instruktur).")
elif paket_3028 == 3 and umur_3028 < 17 and sim_3028 == 'y':
    print("Identitas tidak valid: Belum cukup umur memiliki SIM.")
elif paket_3028 == 3:
    print("Anda belum cukup umur dan tidak boleh bawa motor ATV.")
elif umur_3028 >= 10:
    print("Umur memenuhi syarat untuk menaiki wahana ini.")
else:
    print("Umur belum memenuhi syarat untuk menaiki wahana ini.")

is_member_3028 = input("Apakah Anda member? (y/t)       : ").strip().lower()
kode_promo_valid_3028 = input("Apakah kode promo valid? (y/t)  : ").strip().lower()

subtotal_3028 = harga_satuan_3028 * jumlah_tiket_3028
total_diskon_persen_3028 = 0

# 4) multi-if terpisah - diskon terakumulasi (boleh saling menumpuk)
if subtotal_3028 >= 200000:
    total_diskon_persen_3028 += 10
if is_member_3028 in ['y', 'ya']:
    total_diskon_persen_3028 += 5
if kode_promo_valid_3028 in ['y', 'ya']:
    total_diskon_persen_3028 += 15
if jumlah_tiket_3028 >= 5:
    total_diskon_persen_3028 += 5

nominal_diskon_3028 = subtotal_3028 * (total_diskon_persen_3028 / 100)
total_bayar_3028 = subtotal_3028 - nominal_diskon_3028

# 5) if-else - evaluasi kelulusan audit / bonus
if total_bayar_3028 > 300000:
    print("Selamat! Anda berhak mendapatkan Souvenir Gratis.")
else:
    print("Terima kasih telah berkunjung.")

print("\n=== RINCIAN PEMBAYARAN ===")
print(f"Nama Pengunjung   : {nama_3028}")
